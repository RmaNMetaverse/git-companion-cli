Screen { background: $background; color: $text; }
Header { background: $surface; color: $text-muted; }
#hero { height: 4; padding: 0 2; background: $surface; }
#branch-art { width: 10; color: #64e8cb; text-style: bold; }
#wordmark { width: 1fr; }
#brand { color: #a6a2ff; text-style: bold; height: 2; }
#tagline { color: $text-muted; }
#edition { width: 21; text-align: right; color: #64e8cb; }
#repo { height: 1; padding: 0 3; color: $text-muted; background: $surface; }
#metrics { height: 4; margin: 0 2 1 2; }
#metrics Static { width: 1fr; padding: 1 2; border-left: solid #7066df; background: $surface; margin-right: 1; }
#metric-branch { color: #c6bdff; }
#metric-staged { color: #64e8cb; }
#metric-modified { color: #ffcb8b; }
#metrics #metric-modified { width: 2fr; }
#metric-sync { color: #8bcaff; }
#body { height: 1fr; margin: 0 2; }
#sidebar { width: 27; background: $surface; padding: 1; margin-right: 1; }
.eyebrow { color: $text-muted; text-style: bold; height: 1; margin-bottom: 1; }
#categories { border: none; height: 1fr; background: transparent; }
OptionList { background: $surface; border: none; }
OptionList > .option-list--option { padding: 0 1; }
OptionList > .option-list--option-highlighted { background: $primary 25%; color: $text; text-style: bold; }
OptionList:focus > .option-list--option-highlighted { background: $primary 45%; }
#sidebar-note { color: $text-muted; height: 4; padding-left: 1; }
#main { width: 1fr; }
#search-label { height: 1; color: $text-muted; text-style: bold; }
#search { border: tall $primary 45%; }
#search-tip { height: 1; color: $text-muted; margin-bottom: 1; }
#section { height: 1; color: $text-muted; margin: 0 1 1 1; }
#browser { height: 1fr; min-height: 8; }
#commands { width: 3fr; margin-right: 1; }
#details { width: 2fr; background: $surface; padding: 1 2; }
#detail-content { height: 1fr; }
#detail-title { color: #c6bdff; text-style: bold; margin-bottom: 1; }
#detail-description { margin-bottom: 1; }
#detail-examples, #help-examples { color: $text-muted; }
Collapsible { border: none; padding: 0; margin-bottom: 1; }
Collapsible > CollapsibleTitle { color: #64e8cb; }
Collapsible > Contents { padding: 1 0 0 1; }
#help-examples { margin: 1 0; }
.help-risk { color: #ffcb8b; margin-bottom: 1; }
#detail-risk { color: #ffcb8b; margin-bottom: 1; }
#review { width: 100%; }
#console-bar { height: 3; padding-top: 1; }
#console-bar .eyebrow { width: 18; }
#run-state { width: 1fr; color: #64e8cb; }
#clear { min-width: 7; height: 1; }
#show-results { min-width: 9; height: 1; margin-right: 1; }
#output { height: 7; min-height: 4; background: $surface; border-left: solid #64e8cb; padding: 0 1; }
Footer { background: $surface; }
ModalScreen { align: center middle; background: $background 75%; }
#dialog, #folder-dialog, #help-dialog { width: 76; max-width: 95%; height: auto; max-height: 90%; padding: 1 3; background: $surface; border: round $primary; }
#dialog-title { color: #a6a2ff; text-style: bold; margin-bottom: 1; }
#dialog Label, #folder-dialog Label { margin-top: 1; }
#risk { color: #ffcb8b; margin-top: 1; }
#preview { color: #64e8cb; padding: 1; background: $background; }
#validation, #folder-error { color: #ffb86c; margin-top: 1; }
.buttons { height: 3; margin-top: 1; align-horizontal: right; }
.buttons Button { margin-left: 1; }
Screen.compact #sidebar { width: 22; }
Screen.compact #details { display: none; }
Screen.compact #commands { width: 1fr; }
Screen.compact #body { margin: 0 1; }
Screen.compact #hero { display: none; }
Screen.compact #repo { height: 1; }
Screen.compact #metrics { display: none; }
Screen.compact #search-tip { margin-bottom: 0; }
Screen.compact #section { margin-bottom: 0; }
Screen.compact #browser { min-height: 3; }
Screen.compact #console-bar { height: 2; padding-top: 0; }
Screen.compact #output { height: 4; min-height: 2; }
#results-dialog { width: 96%; height: 94%; border: round $primary; background: $surface; padding: 1 2; }
#result-title { height: 1; text-style: bold; color: #c6bdff; }
#result-command { height: auto; max-height: 3; color: #64e8cb; }
#result-directory { height: 1; color: $text-muted; }
#result-summary { height: auto; margin: 1 0; text-style: bold; }
#results-dialog.running #result-summary { color: #8bcaff; }
#results-dialog.success { border: round #64e8cb; }
#results-dialog.success #result-summary { color: #64e8cb; }
#results-dialog.failure { border: round #ff7777; }
#results-dialog.failure #result-summary { color: #ff7777; }
#results-dialog.stopped #result-summary { color: #ffcb8b; }
#result-log { height: 1fr; min-height: 2; background: $background; padding: 0 1; }
#result-partial { height: auto; max-height: 3; color: $text-muted; }
#result-controls { height: 3; margin-top: 1; align-horizontal: right; }
#result-controls Button { margin-left: 1; }
#result-tip { height: 1; color: $text-muted; }
